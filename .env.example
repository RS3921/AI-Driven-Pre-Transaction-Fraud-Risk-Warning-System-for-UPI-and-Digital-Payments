# ==============================================================================
# UPI Fraud Guard Enterprise — Staging & Production Environment Configuration
# ==============================================================================
# Copy this file to .env and replace with secure values.
# DO NOT commit real API keys, passwords, certificates, or tokens to version control.

# Server Network Configuration
UPI_FRAUD_GUARD_HOST=127.0.0.1
UPI_FRAUD_GUARD_PORT=8000

# Authentication Enforcement (Set to true for staging / production networks)
UPI_FRAUD_GUARD_REQUIRE_AUTH=false

# RBAC User Token Provisioning
# JSON dictionary mapping usernames to 32+ character high-entropy Bearer tokens.
# Supported system roles: 'admin' (super_admin), 'analyst' (fraud_analyst), 'investigator' (investigation_officer), 'auditor' (read_only_auditor)
UPI_FRAUD_GUARD_API_USERS={"admin": "CHANGE_ME_ADMIN_TOKEN_32_CHARACTERS_MINIMUM_AAA", "analyst": "CHANGE_ME_ANALYST_TOKEN_32_CHARACTERS_MINIMUM_BBB"}

# TLS / HTTPS Server Certificates (Required whenever UPI_FRAUD_GUARD_HOST != 127.0.0.1)
UPI_FRAUD_GUARD_TLS_CERT=
UPI_FRAUD_GUARD_TLS_KEY=

# Cyber Threat Intelligence (CTI) & AUIE External Feed Credentials (Optional)
# If omitted or empty, the respective connector/provider reports 'Unconfigured' status without failing.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
OPENPHISH_API_KEY=

# Autonomous CTI Collection Interval in minutes (Default: 30)
CTI_COLLECTION_INTERVAL_MINUTES=30

